# Redis Configuration for Fineract Multi-Node Cache

# Enable Redis cache
FINERACT_REDIS_ENABLED=true

# Redis connection settings
FINERACT_REDIS_HOST=redis
FINERACT_REDIS_PORT=6379
FINERACT_REDIS_PASSWORD=
FINERACT_REDIS_DATABASE=0

# Connection timeouts (milliseconds)
FINERACT_REDIS_TIMEOUT=2000

# Connection pool settings
FINERACT_REDIS_MAX_ACTIVE=8
FINERACT_REDIS_MAX_IDLE=8
FINERACT_REDIS_MIN_IDLE=0
FINERACT_REDIS_MAX_WAIT=-1

# Cache key prefix
FINERACT_REDIS_KEY_PREFIX=fineract:


<!--
    Adds the permissions Synapse uses to protect the Operations Health recovery actions: RESEND_SETTLEMENTCOMPLETION
    re-queues a Settlement Completion that Access never processed, RESCHEDULE_SETTLEMENTBATCH plans again a batch
    refused as future-dated with nothing posted, RESEND_SETTLEMENTEOCCOMPLETION re-queues an EOC Complete whose
    journal is already posted. Fineract owns role/permission assignment; Synapse's AuthzInterceptor enforces it. No
    role is granted here.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'RESEND_SETTLEMENTCOMPLETION'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_savings"/>
            <column name="code" value="RESEND_SETTLEMENTCOMPLETION"/>
            <column name="entity_name" value="SETTLEMENTCOMPLETION"/>
            <column name="action_name" value="RESEND"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'RESCHEDULE_SETTLEMENTBATCH'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_savings"/>
            <column name="code" value="RESCHEDULE_SETTLEMENTBATCH"/>
            <column name="entity_name" value="SETTLEMENTBATCH"/>
            <column name="action_name" value="RESCHEDULE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'RESEND_SETTLEMENTEOCCOMPLETION'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_savings"/>
            <column name="code" value="RESEND_SETTLEMENTEOCCOMPLETION"/>
            <column name="entity_name" value="SETTLEMENTEOCCOMPLETION"/>
            <column name="action_name" value="RESEND"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

<!--
    Adds the two read permissions Synapse uses to protect the settlement reconciliation endpoints, which
    Middleware calls and re-exposes to the Admin Portal: READ_SETTLEMENTBATCH for the pay-window posting
    status reads, READ_SETTLEMENTRECON for the GL balances, the reconciliation breaks and a GL's position.
    Fineract owns role/permission assignment; Synapse's AuthzInterceptor enforces it. Grant them to the
    Settlement Service's service account, which already holds CREATE_SETTLEMENTBATCH.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'READ_SETTLEMENTBATCH'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_savings"/>
            <column name="code" value="READ_SETTLEMENTBATCH"/>
            <column name="entity_name" value="SETTLEMENTBATCH"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'READ_SETTLEMENTRECON'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_savings"/>
            <column name="code" value="READ_SETTLEMENTRECON"/>
            <column name="entity_name" value="SETTLEMENTRECON"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

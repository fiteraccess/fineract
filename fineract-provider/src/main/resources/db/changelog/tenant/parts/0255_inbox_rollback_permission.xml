<!--
    The permission Synapse checks before an operator may "Fail and roll back" a DEAD inbox message: undoing, with contra
    entries, a transaction Fineract rejected and never held. Guarded on its code, like every permission changeset.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'ROLLBACK_INBOXMESSAGE'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="ROLLBACK_INBOXMESSAGE"/>
            <column name="entity_name" value="INBOXMESSAGE"/>
            <column name="action_name" value="ROLLBACK"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-510 revision: the "leave Convenience Fee Income unset to fall back to Commission Income" behavior is
         removed — the account is now always required, at the API layer and in the schema. Backfill any existing
         row that relied on the old fallback with its own commission_income_gl_account_id (the value the fallback
         was already resolving to at read time), then enforce NOT NULL so a future row can't be created without it. -->
    <changeSet author="fiteraccess" id="ab-510-backfill-aggregator-convenience-fee-gl-account">
        <update tableName="m_aggregator_accounting_configuration">
            <column name="convenience_fee_income_gl_account_id" valueComputed="commission_income_gl_account_id"/>
            <where>convenience_fee_income_gl_account_id IS NULL</where>
        </update>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-510-require-aggregator-convenience-fee-gl-account">
        <addNotNullConstraint tableName="m_aggregator_accounting_configuration"
                              columnName="convenience_fee_income_gl_account_id" columnDataType="BIGINT"/>
    </changeSet>

</databaseChangeLog>

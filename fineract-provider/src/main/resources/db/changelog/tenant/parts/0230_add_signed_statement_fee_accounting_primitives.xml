<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-339: seeds the new SIGNED_STATEMENT_FEE savings transaction type, mirroring how COMMISSION/VAT were
         seeded in 0223_add_nip_transfer_accounting_primitives.xml. -->
    <changeSet author="fiteraccess" id="ab-339-add-signed-statement-fee-savings-transaction-enum">
        <insert tableName="r_enum_value">
            <column name="enum_name" value="savings_transaction_type_enum"/>
            <column name="enum_id" valueNumeric="27"/>
            <column name="enum_message_property" value="Signed E-Statement Fee"/>
            <column name="enum_value" value="Signed E-Statement Fee"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- AB-339: seeds the new SIGNED_STATEMENT_FEE_INCOME financial activity so the GL account mapping for the
         signed-statement fee's income leg can be configured via the existing Financial Activity Mappings admin
         screen (same generic mechanism VAT_PAYABLE already uses), with no new admin UI required. -->
    <changeSet author="fiteraccess" id="ab-339-add-signed-statement-fee-income-financial-activity-enum">
        <insert tableName="r_enum_value">
            <column name="enum_name" value="financial_activity_type_enum"/>
            <column name="enum_id" valueNumeric="204"/>
            <column name="enum_message_property" value="Signed E-Statement Fee Income"/>
            <column name="enum_value" value="SIGNED_STATEMENT_FEE_INCOME"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

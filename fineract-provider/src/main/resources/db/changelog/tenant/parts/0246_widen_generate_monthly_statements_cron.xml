<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        AB-358: 02:00 on the 1st through the 5th, instead of the 1st alone. A Synapse outage or deploy during
        that one hour used to cost the whole month's statement run until someone noticed a FAILED job. The
        trigger is already idempotent — Synapse ignores a month it is planning and the tasklet logs
        started=false — so the 2nd-5th are no-ops after a good 1st, and recovery otherwise.
    -->
    <changeSet author="fineract" id="1">
        <update tableName="job">
            <column name="cron_expression" value="0 0 2 1-5 * ?"/>
            <where>name = 'Generate Monthly Statements'</where>
        </update>
    </changeSet>
</databaseChangeLog>

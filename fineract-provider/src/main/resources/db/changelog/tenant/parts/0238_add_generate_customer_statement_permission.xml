<!--
    AB-358 / R-D-40: back-office statement generation. Branch and ops staff may generate an account
    statement on a customer's behalf; Synapse's AuthzInterceptor enforces this permission on the
    Access endpoint, while Fineract remains the owner of role/permission assignment.

    Synapse additionally scopes the rows a holder can reach by m_office.hierarchy, so the permission
    grants the capability but not visibility of every customer.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'GENERATE_CUSTOMER_STATEMENT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="GENERATE_CUSTOMER_STATEMENT"/>
            <column name="entity_name" value="CUSTOMERSTATEMENT"/>
            <column name="action_name" value="GENERATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

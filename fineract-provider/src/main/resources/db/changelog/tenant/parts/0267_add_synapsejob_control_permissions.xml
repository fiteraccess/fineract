<!--
    Adds the permissions Synapse uses to protect its job console controls: EXECUTE_SYNAPSEJOB (Run now),
    UPDATE_SYNAPSEJOB (pause and resume) and UPDATE_SYNAPSEJOBSCHEDULE (the idle interval or the times of day).
    Grouped with READ_SYNAPSEJOB. Fineract owns role/permission assignment; Synapse's AuthzInterceptor enforces it.
    No role is granted here.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'EXECUTE_SYNAPSEJOB'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="jobs"/>
            <column name="code" value="EXECUTE_SYNAPSEJOB"/>
            <column name="entity_name" value="SYNAPSEJOB"/>
            <column name="action_name" value="EXECUTE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'UPDATE_SYNAPSEJOB'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="jobs"/>
            <column name="code" value="UPDATE_SYNAPSEJOB"/>
            <column name="entity_name" value="SYNAPSEJOB"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'UPDATE_SYNAPSEJOBSCHEDULE'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="jobs"/>
            <column name="code" value="UPDATE_SYNAPSEJOBSCHEDULE"/>
            <column name="entity_name" value="SYNAPSEJOBSCHEDULE"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

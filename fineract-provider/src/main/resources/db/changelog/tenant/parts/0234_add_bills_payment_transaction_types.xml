<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-510: seeds the new AGGREGATOR_PAYABLE and CONVENIENCE_FEE savings transaction types, mirroring how
         COMMISSION/VAT were seeded in 0223_add_nip_transfer_accounting_primitives.xml and SIGNED_STATEMENT_FEE in
         0230_add_signed_statement_fee_accounting_primitives.xml. Commission and VAT are reused as-is for
         bills/airtime legs — only these two types are new. -->
    <changeSet author="fiteraccess" id="ab-510-add-bills-payment-savings-transaction-enums">
        <insert tableName="r_enum_value">
            <column name="enum_name" value="savings_transaction_type_enum"/>
            <column name="enum_id" valueNumeric="28"/>
            <column name="enum_message_property" value="Aggregator Payable"/>
            <column name="enum_value" value="Aggregator Payable"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
        <insert tableName="r_enum_value">
            <column name="enum_name" value="savings_transaction_type_enum"/>
            <column name="enum_id" valueNumeric="29"/>
            <column name="enum_message_property" value="Convenience Fee"/>
            <column name="enum_value" value="Convenience Fee"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- AB-510: aggregator_code is the transaction-level counterparty identifier for a bills/airtime posting,
         exactly parallel to switch_id for a NIP transfer (added in 0223_add_nip_transfer_accounting_primitives.xml).
         Kept as its own column rather than reusing switch_id, since a bills posting is not a NIP switch
         transaction. -->
    <changeSet author="fiteraccess" id="ab-510-add-aggregator-code-to-savings-transaction">
        <addColumn tableName="m_savings_account_transaction">
            <column name="aggregator_code" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <!-- AB-510: permissions for the new admin CRUD (mirrors ab-338-add-nip-switch-accounting-configuration-permissions
         in 0223_add_nip_transfer_accounting_primitives.xml). The aggregatoraccounting module's own migration
         (0232_add_aggregator_accounting_configuration.xml) only creates the table; permissions live here alongside
         the other shared-transaction-processing seeds landing in this same PR. -->
    <changeSet author="fiteraccess" id="ab-510-add-aggregator-accounting-configuration-permissions">
        <insert tableName="m_permission">
            <column name="grouping" value="configuration"/>
            <column name="code" value="UPDATE_AGGREGATOR_ACCOUNTING_CONFIGURATION"/>
            <column name="entity_name" value="AGGREGATOR_ACCOUNTING_CONFIGURATION"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="configuration"/>
            <column name="code" value="READ_AGGREGATOR_ACCOUNTING_CONFIGURATION"/>
            <column name="entity_name" value="AGGREGATOR_ACCOUNTING_CONFIGURATION"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- AB-510: permissions Synapse's billing_fee_config admin CRUD checks via AuthzInterceptor.of("READ_BILLINGFEECONFIG"/
         "WRITE_BILLINGFEECONFIG", ...) in AccessModuleInitializer.java. Seeded here per the Synapse PR's own
         follow-up note; mirrors the existing (also-unseeded) READ_NIPFEEPOLICY/WRITE_NIPFEEPOLICY and
         READ_STATEMENTFEESCHEDULE/WRITE_STATEMENTFEESCHEDULE codes, which this migration does not attempt to
         backfill since they predate this ticket and are out of its scope. -->
    <changeSet author="fiteraccess" id="ab-510-add-billing-fee-config-permissions">
        <insert tableName="m_permission">
            <column name="grouping" value="configuration"/>
            <column name="code" value="READ_BILLINGFEECONFIG"/>
            <column name="entity_name" value="BILLINGFEECONFIG"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="configuration"/>
            <column name="code" value="WRITE_BILLINGFEECONFIG"/>
            <column name="entity_name" value="BILLINGFEECONFIG"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

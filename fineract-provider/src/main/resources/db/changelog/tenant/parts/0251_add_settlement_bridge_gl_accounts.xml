<!--
    Adds the bridge GLs that Synapse's settlement collapse posts to: the Bills Bridge per aggregator, and the Inflow and
    Outflow Bridges per NIP switch. They are optional and never read by real-time posting.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fiteraccess" id="ab-462-add-aggregator-bills-bridge-gl-account">
        <addColumn tableName="m_aggregator_accounting_configuration">
            <column name="bills_bridge_gl_account_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="m_aggregator_accounting_configuration"
                                 baseColumnNames="bills_bridge_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_aggregator_accounting_bills_bridge_gl"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-462-add-nip-switch-bridge-gl-accounts">
        <addColumn tableName="m_nip_switch_accounting_configuration">
            <column name="inflow_bridge_gl_account_id" type="BIGINT"/>
            <column name="outflow_bridge_gl_account_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="m_nip_switch_accounting_configuration"
                                 baseColumnNames="inflow_bridge_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_nip_switch_accounting_inflow_bridge_gl"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="m_nip_switch_accounting_configuration"
                                 baseColumnNames="outflow_bridge_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_nip_switch_accounting_outflow_bridge_gl"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>
</databaseChangeLog>

<!--
    The reasons an account restriction may be LIFTED with, as a Manage Codes list beside the four placement
    lists seeded in 0009 — so a lift is reportable by reason the way a placement is, with the free-text
    narration carrying the case detail. Empty here; ops populate the values in Manage Codes. Synapse serves it
    through GET /access/api/v1/restrictions/lift-reasons and validates every lift's reasonCode against it.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code WHERE code_name = 'SavingsAccountUnblockReasons'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code">
            <column name="code_name" value="SavingsAccountUnblockReasons"/>
            <column name="is_system_defined" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-339: every savings withdrawal/deposit command requires a non-null paymentTypeId
         (SavingsAccountTransactionDataValidator#validate), but the signed e-statement fee is a
         platform-initiated debit with no customer-chosen payment method. Seeds a system-defined payment
         type for it, mirroring the existing REPAYMENT_ADJUSTMENT_CHARGEBACK/REFUND rows added in
         0052_loan_transaction_chargeback.xml. Looked up by codeName via Synapse's PaymentTypeCache, not
         this row's id. The id is pinned explicitly (rather than left to autoincrement) because
         PaymentTypeGlobalInitializerStep (fineract-e2e-tests-runner) dynamically creates several payment
         types (AUTOPAY, DOWN_PAYMENT, ...) at E2E-suite startup using whichever id is next available;
         Reporting.feature's fixtures hardcode AUTOPAY at id 103, which an autoincrement-assigned row
         appended here would silently push to 104, breaking that unrelated E2E test as it did in CI. 9000
         is far outside any range either Liquibase-seeded or dynamically E2E-created payment types reach. -->
    <changeSet author="fiteraccess" id="ab-339-add-signed-statement-fee-payment-type">
        <insert tableName="m_payment_type">
            <column name="id" valueNumeric="9000"/>
            <column name="value" value="Signed Statement Fee"/>
            <column name="description" value="System-initiated payment type for the signed e-statement fee; not selectable by customers"/>
            <column name="is_cash_payment" valueBoolean="false"/>
            <column name="order_position" valueNumeric="1"/>
            <column name="code_name" value="SIGNED_STATEMENT_FEE"/>
            <column name="is_system_defined" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>

<!--
    AB-243: records the caller-supplied chargeableAmount on the principal withdrawal row — the base the
    withdrawal fees were computed on when it differs from the transaction amount (0 = fee-exempt). Without
    it, back office sees a percentage fee that does not match fee-rate x transaction-amount (or no fee row
    at all on a fee-mandatory product) with no visible explanation. Nullable: NULL means fees were computed
    on the transaction amount as always; rows booked before this change stay NULL.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fiteraccess" id="ab-243-add-chargeable-amount-to-savings-transaction">
        <addColumn tableName="m_savings_account_transaction">
            <column name="chargeable_amount" type="DECIMAL(19, 6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>

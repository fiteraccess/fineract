<!--
    AB-341. Head Office is the branch every CBN return currently files under, so it needs the two values the
    returns print: the CBN branch sort code (099) and the branch address.

    external_id is the branch code because m_office has no dedicated column for one, and it is already what
    the returns read. Each changeSet only writes a row that still holds the seeded default, so an office whose
    code or address was edited through the API is never overwritten by a redeploy.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1) FROM m_office WHERE id = 1 AND (external_id IS NULL OR external_id = '1')
            </sqlCheck>
        </preConditions>
        <update tableName="m_office">
            <column name="external_id" value="099"/>
            <where>id = 1</where>
        </update>
    </changeSet>
    <changeSet id="2" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1) FROM m_office WHERE id = 1 AND address IS NULL
            </sqlCheck>
        </preConditions>
        <update tableName="m_office">
            <column name="address" value="PLOT 1665, OYIN JOLAYEMI STREET, VICTORIA ISLAND, LAGOS, LAGOS STATE"/>
            <where>id = 1</where>
        </update>
    </changeSet>
</databaseChangeLog>

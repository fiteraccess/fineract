<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-265: EMT Levy (Stamp Duty)
         Synapse owns the rule. Fineract holds the global config rows here so the existing
         "System -> Configurations" admin UI works unchanged; Synapse fetches them via HTTP
         and caches in Redis. Ship with enabled=false: per-product overrides may still apply,
         and ops flips the global flag on per environment. -->

    <changeSet author="fiteraccess" id="ab-265-emt-levy-global-amount">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from c_configuration where name = 'emt-levy'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="emt-levy"/>
            <column name="value" valueNumeric="50"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Default EMT Levy amount in NGN applied to qualifying electronic transfers (computed in Synapse)."/>
        </insert>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-265-emt-levy-base-threshold">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from c_configuration where name = 'emt-levy-base-threshold'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="emt-levy-base-threshold"/>
            <column name="value" valueNumeric="10000"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Transaction amount (inclusive) at and above which EMT Levy applies (evaluated in Synapse)."/>
        </insert>
    </changeSet>

    <!-- Reporting label for the new transaction type SavingsAccountTransactionType.EMT_LEVY(24). -->
    <changeSet author="fiteraccess" id="ab-265-emt-levy-r-enum-value">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from r_enum_value where enum_name = 'savings_transaction_type_enum' and enum_id = 24</sqlCheck>
        </preConditions>
        <insert tableName="r_enum_value">
            <column name="enum_name" value="savings_transaction_type_enum"/>
            <column name="enum_id" valueNumeric="24"/>
            <column name="enum_message_property" value="EMT Levy"/>
            <column name="enum_value" value="EMT Levy"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

<!--
    Persists the switch-fee / bank-commission split on Commission savings transactions. The split arrives
    from the upstream caller at booking time but was previously carried only in-flight to the journal step,
    so reversing a Commission row later could not rebuild the two-leg accounting allocation. Nullable:
    only COMMISSION rows carry values; rows booked before this change stay NULL (their reversal fails to
    the operational posture by design — no backfill).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fiteraccess" id="ab-412-persist-commission-allocation">
        <addColumn tableName="m_savings_account_transaction">
            <column name="switch_fee_amount" type="DECIMAL(19, 6)">
                <constraints nullable="true"/>
            </column>
            <column name="bank_commission_amount" type="DECIMAL(19, 6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>

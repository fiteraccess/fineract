<!--
    AB-548: lets a reopening restore exactly the standing instructions its closure disabled.

    Closing a savings account flips every ACTIVE standing instruction linked to it to DISABLED. Without a
    marker, a DISABLED instruction is indistinguishable from one a customer or operator switched off
    deliberately beforehand — so reopening could only either restore nothing, or restart money movement
    nobody asked to restart. This column records which rows the closure itself changed.

    Defaults to false, so every pre-existing DISABLED instruction is treated as deliberately disabled and
    is left alone by a reopening.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_account_transfer_standing_instructions" columnName="disabled_by_closure"/>
            </not>
        </preConditions>
        <addColumn tableName="m_account_transfer_standing_instructions">
            <column name="disabled_by_closure" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>

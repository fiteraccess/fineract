<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-510: relabels the savings_transaction_type_enum row seeded in 0234_add_bills_payment_transaction_types.xml.
         SavingsAccountTransactionType.AGGREGATOR_PAYABLE(28) was renamed to BILL_PAYMENT(28) — same id, but the label
         now describes what the primary bills/airtime withdrawal transaction actually is, rather than the aggregator's
         own payable leg (which the row never represented; it always tagged the customer-facing debit). A new
         changeset is used instead of editing that migration in place because it has already run against Dev. -->
    <changeSet author="fiteraccess" id="ab-510-rename-aggregator-payable-to-bill-payment">
        <update tableName="r_enum_value">
            <column name="enum_message_property" value="Bill Payment"/>
            <column name="enum_value" value="Bill Payment"/>
            <where>enum_name = 'savings_transaction_type_enum' AND enum_id = 28</where>
        </update>
    </changeSet>

</databaseChangeLog>

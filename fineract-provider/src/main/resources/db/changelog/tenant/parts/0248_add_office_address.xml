<!--
    AB-341. The CBN "Weekly Returns on Newly Opened Bank Accounts" files a Branch Address per account, which
    nothing in Fineract recorded: m_office carries only name, hierarchy and external_id, and the m_address
    tables are client-scoped and unused here (enable-address is off).

    One free-text column rather than a structured address, because the return files the branch address as a
    single line and a regulator-facing format is the only consumer.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_office" columnName="address"/>
            </not>
        </preConditions>
        <addColumn tableName="m_office">
            <column name="address" type="varchar(500)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

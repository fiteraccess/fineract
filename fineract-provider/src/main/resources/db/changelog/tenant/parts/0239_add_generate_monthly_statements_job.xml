<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        AB-358 (R-D-24): the monthly customer statement run. Quartz is the only schedule for it — Synapse
        deliberately has no run-day/run-hour setting, so this row is where the timing lives. Registering it here
        is also what puts the run in the web-app's Manage Jobs page, giving it run history and a manual re-run.

        Ships active: the previous arrangement skipped the month outright if Synapse happened to be down for the
        single hour it checked, and a misfire here is recoverable instead.
    -->
    <changeSet author="fineract" id="1">
        <insert tableName="job">
            <column name="name" value="Generate Monthly Statements"/>
            <column name="display_name" value="Generate Monthly Statements"/>
            <column name="short_name" value="STMT_MON"/>
            <column name="cron_expression" value="0 0 2 1 * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Generate Monthly StatementsJobDetail1 _DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>

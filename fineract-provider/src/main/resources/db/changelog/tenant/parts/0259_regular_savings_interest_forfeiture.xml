<!--
    AB-566. A Regular Savings product carries a monthly withdrawal rule, one row per month it changes (a product
    without a row runs on the defaults). Synapse counts the qualifying withdrawals and replays each month's
    eligibility here; end-of-day accrual and month-end posting read it.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
 <changeSet id="ab-566-withdrawal-rule" author="fiteraccess">
  <preConditions onFail="MARK_RAN"><not><tableExists tableName="m_savings_product_withdrawal_rule"/></not></preConditions>
  <createTable tableName="m_savings_product_withdrawal_rule">
   <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_m_savings_product_withdrawal_rule" nullable="false"/></column>
   <column name="product_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_m_savings_product_withdrawal_rule_product" references="m_savings_product(id)" deleteCascade="true"/></column>
   <column name="effective_from" type="DATE"><constraints nullable="false"/></column>
   <column name="withdrawal_counter_enabled" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
   <column name="monthly_withdrawal_threshold" type="INT" defaultValueNumeric="4"><constraints nullable="false"/></column>
   <column name="qualifying_withdrawal_types" type="VARCHAR(200)"><constraints nullable="false"/></column>
  </createTable>
  <addUniqueConstraint tableName="m_savings_product_withdrawal_rule" columnNames="product_id, effective_from" constraintName="uq_m_savings_product_withdrawal_rule_month"/>
  <rollback><dropTable tableName="m_savings_product_withdrawal_rule"/></rollback>
 </changeSet>
 <!-- The primary key serves the posting page's lookup by account; the month index serves the accrual run's by month. -->
 <changeSet id="ab-566-interest-forfeiture" author="fiteraccess">
  <preConditions onFail="MARK_RAN"><not><tableExists tableName="m_savings_interest_forfeiture"/></not></preConditions>
  <createTable tableName="m_savings_interest_forfeiture">
   <column name="savings_account_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_m_savings_interest_forfeiture_account" references="m_savings_account(id)" deleteCascade="true"/></column>
   <column name="governing_month" type="DATE"><constraints nullable="false"/></column>
   <column name="forfeited" type="BOOLEAN"><constraints nullable="false"/></column>
   <column name="transition_seq" type="BIGINT"><constraints nullable="false"/></column>
   <column name="source_transition_id" type="VARCHAR(100)"/>
   <column name="updated_on_utc" type="DATETIME"><constraints nullable="false"/></column>
  </createTable>
  <addPrimaryKey tableName="m_savings_interest_forfeiture" columnNames="savings_account_id, governing_month" constraintName="pk_m_savings_interest_forfeiture"/>
  <createIndex tableName="m_savings_interest_forfeiture" indexName="idx_m_savings_interest_forfeiture_month"><column name="governing_month"/></createIndex>
  <rollback><dropTable tableName="m_savings_interest_forfeiture"/></rollback>
 </changeSet>
 <changeSet id="ab-566-interest-forfeiture-permission" author="fiteraccess">
  <preConditions onFail="MARK_RAN"><sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'REPLAYINTERESTFORFEITURE_SAVINGSACCOUNT'</sqlCheck></preConditions>
  <insert tableName="m_permission">
   <column name="grouping" value="transaction_savings"/>
   <column name="code" value="REPLAYINTERESTFORFEITURE_SAVINGSACCOUNT"/>
   <column name="entity_name" value="SAVINGSACCOUNT"/>
   <column name="action_name" value="REPLAYINTERESTFORFEITURE"/>
   <column name="can_maker_checker" valueBoolean="false"/>
  </insert>
  <rollback><delete tableName="m_permission"><where>code = 'REPLAYINTERESTFORFEITURE_SAVINGSACCOUNT'</where></delete></rollback>
 </changeSet>
</databaseChangeLog>

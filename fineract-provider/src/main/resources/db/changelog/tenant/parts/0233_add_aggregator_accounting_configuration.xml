<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- AB-510: creates the aggregator-to-GL mapping table used by Synapse's Bills Payment & Airtime Posting
         flow, mirroring m_nip_switch_accounting_configuration from 0223_add_nip_transfer_accounting_primitives.xml.
         Unlike NIP there is no direction concept: a bills/airtime posting is always outbound, so the payable and
         commission income accounts are always required, and the convenience fee income account is optional (some
         aggregators reuse their commission account for convenience fee too). -->
    <changeSet author="fiteraccess" id="ab-510-create-aggregator-accounting-configuration">
        <createTable tableName="m_aggregator_accounting_configuration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="aggregator_code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_aggregator_accounting_configuration_aggregator_code"/>
            </column>
            <column name="aggregator_payable_gl_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="commission_income_gl_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="convenience_fee_income_gl_account_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_aggregator_accounting_configuration"
                                 baseColumnNames="aggregator_payable_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_aggregator_accounting_payable_gl"/>
        <addForeignKeyConstraint baseTableName="m_aggregator_accounting_configuration"
                                 baseColumnNames="commission_income_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_aggregator_accounting_commission_income_gl"/>
        <addForeignKeyConstraint baseTableName="m_aggregator_accounting_configuration"
                                 baseColumnNames="convenience_fee_income_gl_account_id"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"
                                 constraintName="fk_aggregator_accounting_convenience_fee_income_gl"/>
    </changeSet>

</databaseChangeLog>

<!--
    AB-416: generic, direction-aware (switch, direction) -> GL account configuration, so any NIP
    switch (NIBSS/Hydrogen/Etranzact/...) can be mapped to a Principal account (always), plus a
    Switch-Fee and Bank-Commission account (outbound only - inbound NIP credits carry no fee).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-table">
        <createTable tableName="acc_gl_switch_configuration">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="switch_code" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="principal_gl_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="switch_fee_gl_account_id" type="BIGINT"/>
            <column name="bank_commission_gl_account_id" type="BIGINT"/>
            <column defaultValueBoolean="true" name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-unique-constraint">
        <addUniqueConstraint tableName="acc_gl_switch_configuration" columnNames="switch_code, direction"
                              constraintName="uq_switch_code_direction"/>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-fk-principal">
        <addForeignKeyConstraint baseColumnNames="principal_gl_account_id" baseTableName="acc_gl_switch_configuration"
                                  constraintName="fk_switch_gl_configuration_principal" referencedColumnNames="id"
                                  referencedTableName="acc_gl_account" onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-fk-fee">
        <addForeignKeyConstraint baseColumnNames="switch_fee_gl_account_id" baseTableName="acc_gl_switch_configuration"
                                  constraintName="fk_switch_gl_configuration_fee" referencedColumnNames="id"
                                  referencedTableName="acc_gl_account" onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-fk-commission">
        <addForeignKeyConstraint baseColumnNames="bank_commission_gl_account_id" baseTableName="acc_gl_switch_configuration"
                                  constraintName="fk_switch_gl_configuration_commission" referencedColumnNames="id"
                                  referencedTableName="acc_gl_account" onDelete="RESTRICT" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-permission-read">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_SWITCHGLCONFIGURATION'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="READ_SWITCHGLCONFIGURATION"/>
            <column name="entity_name" value="SWITCHGLCONFIGURATION"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-permission-create">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'CREATE_SWITCHGLCONFIGURATION'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="CREATE_SWITCHGLCONFIGURATION"/>
            <column name="entity_name" value="SWITCHGLCONFIGURATION"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-permission-update">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'UPDATE_SWITCHGLCONFIGURATION'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="UPDATE_SWITCHGLCONFIGURATION"/>
            <column name="entity_name" value="SWITCHGLCONFIGURATION"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fiteraccess" id="ab-416-switch-gl-configuration-permission-delete">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'DELETE_SWITCHGLCONFIGURATION'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="DELETE_SWITCHGLCONFIGURATION"/>
            <column name="entity_name" value="SWITCHGLCONFIGURATION"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>

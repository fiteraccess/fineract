<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        Lower fillfactor on m_savings_account leaves ~20% free space per page so PostgreSQL can perform HOT
        (heap-only tuple) updates in place when the deposit/withdrawal hot path runs. Combined with the narrow
        delta-based JPQLs (applyDepositDelta, applyWithdrawalDelta), this avoids PK-index maintenance and keeps the
        new tuple version on the same page, dramatically reducing WAL volume and lock-hold time on contended
        accounts. Existing rows pick up the new fillfactor gradually as they are updated; a one-time off-hours
        VACUUM FULL m_savings_account realises it immediately.
    -->
    <changeSet author="fineract" id="1" context="postgresql">
        <sql>
            ALTER TABLE m_savings_account SET (fillfactor = 80);
        </sql>
    </changeSet>
</databaseChangeLog>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        Covering index for GET /v1/savingsaccounts/{savingsId}/transactions/page.
        Key order matches the endpoint's keyset (transaction_date, id; DESC, or ASC by backward scan), so a
        page seeks to its cursor and reads ids in order, stopping at LIMIT with no sort. The INCLUDE columns
        are the endpoint's filters, so the page-id query is an index-only scan instead of visiting the
        account's heap pages (an EXPLAIN on a 7k-transaction account showed 358 heap pages read just to
        count it). The endpoint deliberately runs no COUNT.
        CREATE INDEX CONCURRENTLY cannot run inside a transaction, hence runInTransaction="false"; the
        IF NOT EXISTS guard makes a re-run after a manual pre-build a no-op.
    -->
    <changeSet author="fineract" id="1" context="postgresql" runInTransaction="false">
        <sql splitStatements="false">
            CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_sat_account_page
                ON m_savings_account_transaction (savings_account_id, transaction_date DESC, id DESC)
                INCLUDE (is_reversed, is_reversal, transaction_type_enum);
        </sql>
    </changeSet>
</databaseChangeLog>
